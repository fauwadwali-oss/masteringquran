{
  "name": "mastering-quran",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/prerender/generate.mjs",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "mobile:sync": "SKIP_PRERENDER=1 npm run build && cap sync",
    "mobile:android": "SKIP_PRERENDER=1 npm run build && cap sync android && cap open android",
    "mobile:ios": "SKIP_PRERENDER=1 npm run build && cap sync ios && cap open ios",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "auth-emails": "esbuild scripts/auth-emails/generate.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/auth-emails.mjs && node node_modules/.cache/auth-emails.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.3.1",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.3.1",
    "@capgo/capacitor-media-session": "^8.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.39.8",
    "adhan": "4.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@cloudflare/workers-types": "^4.20260418.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  }
}
