<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/verse_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/verse_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FBBF24"
        android:textSize="12sp"
        android:text="@string/widget_name"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/verse_arabic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:src="@mipmap/ic_launcher"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/verse_english"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_description"
        android:textColor="#EAFBF3"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/verse_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:background="@drawable/verse_widget_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="@string/widget_continue"
        android:textColor="#022C22"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
