 "duas": [
  {"id": "morning-bika-asbahna", "category": "morning-evening", "title": "In the morning", "source": {"type": "hadith", "collection": "tirmidhi", "ref": "3391"}, "arabic": {"from": "اللهم بك اصبحنا وبك امسينا", "to": "واليك المصير"}, "transliteration": {"from": "Allāhumma bika aṣbaḥnā", "to": "wa ilaikal-maṣīr"}},
  {"id": "evening-bika-amsayna", "category": "morning-evening", "title": "In the evening", "source": {"type": "hadith", "collection": "tirmidhi", "ref": "3391"}, "arabic": {"from": "اللهم بك امسينا وبك اصبحنا", "to": "واليك النشور"}, "translation": {"from": "O Allah, by You we enter the evening", "to": "and to You is the Resurrection"}, "transliteration": {"from": "Allāhumma bika amsainā", "to": "wa ilaikan-nushūr"}},
  {"id": "evening-amsayna", "category": "morning-evening", "title": "In the evening: the kingdom belongs to Allah", "source": {"type": "hadith", "collection": "muslim", "ref": "2723"}, "arabic": [{"from": "امسينا وامسى الملك لله", "to": "لا شريك له"}, {"from": "له الملك وله الحمد", "to": "وعذاب فى القبر"}], "translation": [{"from": "We entered upon evening", "to": "the One Who has no partner with Him."}, {"from": "His is the Sovereignty", "to": "torment in the grave"}]},
  {"id": "bismillah-la-yadurr", "category": "morning-evening", "title": "For protection, three times morning and evening", "source": {"type": "hadith", "collection": "abudawud", "ref": "5088"}, "arabic": {"from": "بسم الله الذي لا يضر", "to": "وهو السميع العليم"}, "translation": {"from": "In the name of Allah, when Whose name is mentioned", "to": "the Hearer, the Knower"}, "count": {"value": 3, "evidence": "If anyone says three times"}},
  {"id": "sleep-bismika", "category": "sleep", "title": "Going to bed", "source": {"type": "hadith", "collection": "bukhari", "ref": "6312"}, "arabic": {"from": "باسمك اموت واحيا"}, "transliteration": {"from": "Bismika amutu wa ahya"}},
  {"id": "waking-alhamdulillah", "category": "sleep", "title": "Waking up", "source": {"type": "hadith", "collection": "bukhari", "ref": "6312"}, "arabic": {"from": "الحمد لله الذي احيانا", "to": "واليه النشور"}, "transliteration": {"from": "Al-hamdu li l-lahil-ladhi ahyana", "to": "wa ilaihin-nushur"}},
  {"id": "sleep-aslamtu", "category": "sleep", "title": "The last words before sleep", "source": {"type": "hadith", "collection": "bukhari", "ref": "247"}, "arabic": {"from": "اللهم اسلمت وجهى اليك", "to": "وبنبيك الذى ارسلت", "first": true}, "translation": {"from": "O Allah! I surrender to You", "to": "whom You have sent"}, "transliteration": {"from": "Allahumma aslamtu wajhi ilaika", "to": "l ladhi arsalta"}},
  {"id": "after-wudu", "category": "prayer", "title": "After wudu", "source": {"type": "hadith", "collection": "muslim", "ref": "234"}, "arabic": {"from": "اشهد ان لا اله الا الله وان محمدا", "to": "عبد الله ورسوله"}, "translation": {"from": "I testify that there is no god but Allah", "to": "the servant of Allah and His Messenger"}},
  {"id": "opening-baid", "category": "prayer", "title": "Opening the prayer", "source": {"type": "hadith", "collection": "bukhari", "ref": "744"}, "arabic": {"from": "اللهم باعد بينى", "to": "بالماء والثلج والبرد"}, "translation": {"from": "O Allah! Set me apart from my sins", "to": "water, snow and hail"}, "transliteration": {"from": "Allahumma, baa`id baini", "to": "wa l-barad"}},
  {"id": "after-salam-antas-salam", "category": "prayer", "title": "After the salam", "source": {"type": "hadith", "collection": "muslim", "ref": "591"}, "arabic": {"from": "اللهم انت السلام", "to": "ذا الجلال والاكرام"}, "translation": {"from": "O Allah! Thou art Peace", "to": "O Possessor of Glory and Honour"}},
  {"id": "after-prayer-aini", "category": "prayer", "title": "After every prayer", "source": {"type": "hadith", "collection": "abudawud", "ref": "1522"}, "arabic": {"from": "اللهم اعنى على ذكرك", "to": "وحسن عبادتك"}, "translation": {"from": "O Allah, help me in remembering You", "to": "worshipping You well."}},
  {"id": "leaving-home", "category": "home-masjid", "title": "Leaving home", "source": {"type": "hadith", "collection": "abudawud", "ref": "5095"}, "arabic": {"from": "بسم الله توكلت على الله", "to": "الا بالله"}, "translation": {"from": "In the name of Allah, I trust in Allah", "to": "no power but in Allah"}},
  {"id": "entering-masjid", "category": "home-masjid", "title": "Entering the masjid", "source": {"type": "hadith", "collection": "muslim", "ref": "713"}, "arabic": {"from": "اللهم افتح لى ابواب رحمتك"}, "translation": {"from": "O Allah! open for me the doors of Thy mercy"}},
  {"id": "leaving-masjid", "category": "home-masjid", "title": "Leaving the masjid", "source": {"type": "hadith", "collection": "muslim", "ref": "713"}, "arabic": {"from": "اللهم انى اسالك من فضلك"}, "translation": {"from": "O Allah! I beg of Thee Thy Grace"}},
  {"id": "entering-toilet", "category": "home-masjid", "title": "Entering the toilet", "source": {"type": "hadith", "collection": "bukhari", "ref": "6322"}, "arabic": {"from": "اللهم انى اعوذ بك من الخبث", "to": "والخبائث"}, "transliteration": {"from": "Allahumma inni a`udhu bika", "to": "wal khaba'ith"}},
  {"id": "food-forgot-bismillah", "category": "food", "title": "If you forgot Bismillah before eating", "source": {"type": "hadith", "collection": "abudawud", "ref": "3767"}, "arabic": {"from": "بسم الله اوله واخره"}, "translation": {"from": "In the name of Allah at the beginning and at the end of it"}},
  {"id": "after-eating", "category": "food", "title": "After eating", "source": {"type": "hadith", "collection": "abudawud", "ref": "4023"}, "arabic": {"from": "الحمد لله الذى اطعمنى", "to": "ولا قوة", "first": true}, "translation": {"from": "Praise be to Allah Who has fed me", "to": "no might and power on my part"}},
  {"id": "breaking-fast", "category": "food", "title": "Breaking the fast", "source": {"type": "hadith", "collection": "abudawud", "ref": "2357"}, "arabic": {"from": "ذهب الظما", "to": "ان شاء الله"}, "translation": {"from": "Thirst has gone", "to": "if Allah wills"}},
  {"id": "travel", "category": "travel", "title": "Setting out on a journey", "source": {"type": "hadith", "collection": "muslim", "ref": "1342"}, "arabic": {"from": "سبحان الذى سخر لنا هذا", "to": "فى المال والاهل"}, "translation": {"from": "Hallowed is He Who subdued for us", "to": "property and family on return."}},
  {"id": "travel-return", "category": "travel", "title": "Words added when returning from a journey", "source": {"type": "hadith", "collection": "muslim", "ref": "1342"}, "arabic": {"from": "ايبون تائبون عابدون لربنا حامدون"}, "translation": {"from": "We are returning, repentant, worshipping our Lord. and praising Him"}},
  {"id": "distress-karb", "category": "distress", "title": "In times of distress", "source": {"type": "hadith", "collection": "bukhari", "ref": "6345"}, "arabic": {"from": "لا اله الا الله العظيم الحليم", "to": "رب العرش العظيم"}, "transliteration": {"from": "La ilaha illal-lahu Al-`Azim", "to": "Rabbu-l-arsh il-azim"}},
  {"id": "anxiety-hamm", "category": "distress", "title": "For worry, grief and debt", "source": {"type": "hadith", "collection": "bukhari", "ref": "6369"}, "arabic": {"from": "اللهم انى اعوذ بك من الهم والحزن", "to": "وغلبة الرجال"}, "translation": {"from": "O Allah! I seek refuge with You from worry and grief", "to": "overpowered by (other) men."}},
  {"id": "calamity-istirja", "category": "distress", "title": "When afflicted by a calamity", "source": {"type": "hadith", "collection": "muslim", "ref": "918"}, "arabic": {"from": "انا لله وانا اليه راجعون", "to": "واخلف لى خيرا منها"}, "translation": {"from": "We belong to Allah and to Him shall we return", "to": "something better than it in exchange for it"}},
  {"id": "debt-ikfini", "category": "distress", "title": "For debt and provision", "source": {"type": "hadith", "collection": "tirmidhi", "ref": "3563"}, "arabic": {"from": "اللهم اكفنى بحلالك", "to": "عمن سواك"}, "translation": {"from": "O Allah, suffice me with Your lawful", "to": "all those besides You"}, "transliteration": {"from": "Allāhummakfinī", "to": "`amman siwāka"}},
  {"id": "sayyid-al-istighfar", "category": "forgiveness", "title": "Sayyid al-Istighfar, the best way to ask forgiveness", "source": {"type": "hadith", "collection": "bukhari", "ref": "6306"}, "arabic": {"from": "اللهم انت ربى", "to": "لا يغفر الذنوب الا انت"}, "transliteration": {"from": "Allahumma anta Rabbi", "to": "la yaghfiru adhdhunuba illa anta"}},
  {"id": "rabbighfirli-wa-tub", "category": "forgiveness", "title": "Asking forgiveness, said a hundred times in one sitting", "source": {"type": "hadith", "collection": "tirmidhi", "ref": "3434"}, "arabic": {"from": "رب اغفر لى وتب على", "to": "التواب الغفور"}, "translation": {"from": "O my Lord, forgive me", "to": "the Most Forgiving"}, "transliteration": {"from": "Rabbighfirlī", "to": "antat-Tawwābul-Ghafūr"}, "count": {"value": 100, "evidence": "a hundred time"}},
  {"id": "visiting-sick", "category": "illness", "title": "Visiting someone who is ill", "source": {"type": "hadith", "collection": "bukhari", "ref": "5656"}, "arabic": {"from": "لا باس طهور ان شاء الله", "first": true}, "translation": {"from": "Don't worry, if Allah will, it will be expiation (for your sins)"}},
  {"id": "healing-rabb-an-nas", "category": "illness", "title": "Asking Allah to heal", "source": {"type": "hadith", "collection": "bukhari", "ref": "5743"}, "arabic": {"from": "اللهم رب الناس", "to": "لا يغادر سقما"}, "translation": {"from": "O Allah, the Lord of the people!", "to": "leave behind no ailment"}},
  {"id": "kalimat-tammat", "category": "protection", "title": "When stopping at a place", "source": {"type": "hadith", "collection": "muslim", "ref": "2708"}, "arabic": {"from": "اعوذ بكلمات الله التامات", "to": "من شر ما خلق"}, "translation": {"from": "I seek refuge in the Perfect Word of Allah", "to": "the evil of what He has created"}},
  {"id": "guidance-huda", "category": "guidance", "title": "For guidance, piety, chastity and freedom from need", "source": {"type": "hadith", "collection": "muslim", "ref": "2721"}, "arabic": {"from": "اللهم انى اسالك الهدى", "to": "والغنى"}, "translation": {"from": "O Allah. I beg of Thee the right guidance", "to": "freedom from want"}},
  {"id": "steadfast-heart", "category": "guidance", "title": "For a steadfast heart", "source": {"type": "hadith", "collection": "tirmidhi", "ref": "2140"}, "arabic": {"from": "يا مقلب القلوب", "to": "على دينك"}, "translation": {"from": "O Changer of the Hearts!", "to": "upon Your Religion."}, "transliteration": {"from": "Ya Muqallibal-qulub", "to": "'ala dinik"}},
  {"id": "beneficial-knowledge", "category": "guidance", "title": "For beneficial knowledge, and refuge from the Fire", "source": {"type": "hadith", "collection": "tirmidhi", "ref": "3599"}, "arabic": {"from": "اللهم انفعنى بما علمتنى", "to": "من حال اهل النار"}, "translation": {"from": "O Allah, benefit me with that which You have taught me", "to": "the condition of the people of the Fire"}, "transliteration": {"from": "Allāhummanfa`nī", "to": "min ḥāli ahlin-nār"}},
  {"id": "marriage-barakallah", "category": "family", "title": "Congratulating someone on their marriage", "source": {"type": "hadith", "collection": "abudawud", "ref": "2130"}, "arabic": {"from": "بارك الله لك", "to": "فى خير"}, "translation": {"from": "May Allah bless for you", "to": "in good (works)"}},
  {"id": "children-protection", "category": "family", "title": "Seeking protection for children", "source": {"type": "hadith", "collection": "tirmidhi", "ref": "2060"}, "arabic": {"from": "اعيذكما بكلمات الله التامة", "to": "من كل عين لامة"}, "translation": {"from": "I seek refuge for the two of you", "to": "from every harmful eye"}, "transliteration": {"from": "U'idhukuma bikalimatillahi-tammati", "to": "lammah"}},
  {"id": "laylat-al-qadr", "category": "special", "title": "On Laylat al-Qadr", "source": {"type": "hadith", "collection": "ibnmajah", "ref": "3850"}, "arabic": {"from": "اللهم انك عفو تحب العفو", "to": "فاعف عنى"}, "translation": {"from": "O Allah, You are Forgiving", "to": "so forgive me"}, "transliteration": {"from": "Allahumma innaka 'afuwwun", "to": "fa'fu 'anni"}},
  {"id": "day-of-arafah", "category": "special", "title": "On the Day of Arafah", "source": {"type": "hadith", "collection": "tirmidhi", "ref": "3585"}, "arabic": {"from": "لا اله الا الله وحده", "to": "على كل شىء قدير"}, "translation": {"from": "None has the right to be worshipped but Allah", "to": "powerful over all things."}, "transliteration": {"from": "Lā ilāha illallāh, waḥdahu", "to": "kulli shai’in qadīr"}},
  {"id": "new-moon", "category": "special", "title": "On seeing the new moon", "source": {"type": "hadith", "collection": "tirmidhi", "ref": "3451"}, "arabic": {"from": "اللهم اهلله علينا", "to": "ربى وربك الله"}, "translation": {"from": "O Allah, bring it over us", "to": "My Lord and your Lord is Allah"}, "transliteration": {"from": "Allāhumma ahlilhu", "to": "rabbuk Allāh"}},
  {"id": "rain", "category": "special", "title": "When it rains", "source": {"type": "hadith", "collection": "nasai", "ref": "1523"}, "arabic": {"from": "اللهم اجعله صيبا نافعا"}, "translation": {"from": "O Allah, make it beneficial rain"}, "transliteration": {"from": "Allahummaj'alhu Sayyiban nafi`a"}},
  {"id": "talbiyah", "category": "special", "title": "The Talbiyah of Hajj and Umrah", "source": {"type": "hadith", "collection": "bukhari", "ref": "1549"}, "arabic": {"from": "لبيك اللهم لبيك", "to": "والملك، لا شريك لك"}, "translation": {"from": "I respond to Your call O Allah", "to": "no partners with You"}, "transliteration": {"from": "Labbaika Allahumma labbaik", "to": "La sharika Laka"}},
  {"id": "subhanallah-wa-bihamdihi", "category": "dhikr", "title": "Glorifying Allah, a hundred times a day", "source": {"type": "hadith", "collection": "bukhari", "ref": "6405"}, "arabic": {"from": "سبحان الله وبحمده"}, "transliteration": {"from": "Subhan Allah wa bihamdihi"}, "count": {"value": 100, "evidence": "one hundred times a day"}},
  {"id": "q-2-127", "category": "quran", "title": "Our Lord, accept from us", "source": {"type": "quran", "surah": 2, "ayahs": [127]}, "arabic": {"from": "ربنا تقبل منا", "to": "العليم"}, "translation": {"from": "Our Lord, accept [this] from us", "to": "the Knowing."}},
  {"id": "q-2-201", "category": "quran", "title": "Good in this world and the Hereafter", "source": {"type": "quran", "surah": 2, "ayahs": [201]}, "arabic": {"from": "ربنا ءاتنا", "to": "النار"}, "translation": {"from": "Our Lord, give us", "to": "punishment of the Fire."}},
  {"id": "q-2-286", "category": "quran", "title": "Do not burden us", "source": {"type": "quran", "surah": 2, "ayahs": [286]}, "arabic": {"from": "ربنا لا تؤاخذنا", "to": "الكفرين"}, "translation": {"from": "Our Lord, do not impose blame upon us", "to": "the disbelieving people."}},
  {"id": "q-3-8", "category": "quran", "title": "Do not let our hearts deviate", "source": {"type": "quran", "surah": 3, "ayahs": [8]}, "translation": {"from": "Our Lord, let not our hearts deviate", "to": "You are the Bestower."}},
  {"id": "q-3-173", "category": "quran", "title": "Allah is sufficient for us", "source": {"type": "quran", "surah": 3, "ayahs": [173]}, "arabic": {"from": "حسبنا الله", "to": "الوكيل"}, "translation": {"from": "Sufficient for us is Allāh", "to": "Disposer of affairs."}},
  {"id": "q-7-23", "category": "quran", "title": "The dua of Adam and Hawwa", "source": {"type": "quran", "surah": 7, "ayahs": [23]}, "arabic": {"from": "ربنا ظلمنا", "to": "الخسرين"}, "translation": {"from": "Our Lord, we have wronged ourselves", "to": "among the losers."}},
  {"id": "q-14-40-41", "category": "quran", "title": "For prayer, parents and believers", "source": {"type": "quran", "surah": 14, "ayahs": [40, 41]}, "translation": {"from": "My Lord, make me an establisher of prayer", "to": "the Day the account is established."}},
  {"id": "q-17-24", "category": "quran", "title": "For one's parents", "source": {"type": "quran", "surah": 17, "ayahs": [24]}, "arabic": {"from": "رب ارحمهما", "to": "صغيرا"}, "translation": {"from": "My Lord, have mercy upon them", "to": "[when I was] small."}},
  {"id": "q-18-10", "category": "quran", "title": "Mercy and right guidance", "source": {"type": "quran", "surah": 18, "ayahs": [10]}, "arabic": {"from": "ربنا ءاتنا من لدنك", "to": "رشدا"}, "translation": {"from": "Our Lord, grant us from Yourself mercy", "to": "right guidance."}},
  {"id": "q-20-114", "category": "quran", "title": "Increase me in knowledge", "source": {"type": "quran", "surah": 20, "ayahs": [114]}, "arabic": {"from": "رب زدنى علما"}, "translation": {"from": "My Lord, increase me in knowledge."}},
  {"id": "q-21-87", "category": "quran", "title": "The dua of Yunus", "source": {"type": "quran", "surah": 21, "ayahs": [87]}, "arabic": {"from": "لا اله الا انت", "to": "الظلمين"}, "translation": {"from": "There is no deity except You", "to": "of the wrongdoers."}},
  {"id": "q-23-118", "category": "quran", "title": "Forgive and have mercy", "source": {"type": "quran", "surah": 23, "ayahs": [118]}, "arabic": {"from": "رب اغفر وارحم", "to": "الرحمين"}, "translation": {"from": "My Lord, forgive and have mercy", "to": "the best of the merciful."}},
  {"id": "q-25-74", "category": "quran", "title": "For spouses and children", "source": {"type": "quran", "surah": 25, "ayahs": [74]}, "arabic": {"from": "ربنا هب لنا", "to": "اماما"}, "translation": {"from": "Our Lord, grant us from among", "to": "for the righteous."}},
  {"id": "q-28-24", "category": "quran", "title": "In need of any good", "source": {"type": "quran", "surah": 28, "ayahs": [24]}, "arabic": {"from": "رب انى لما انزلت", "to": "فقير"}, "translation": {"from": "My Lord, indeed I am", "to": "in need."}},
  {"id": "q-46-15", "category": "quran", "title": "Gratitude, parents and offspring", "source": {"type": "quran", "surah": 46, "ayahs": [15]}, "arabic": {"from": "رب اوزعنى", "to": "المسلمين"}, "translation": {"from": "My Lord, enable me to be grateful", "to": "the Muslims."}},
  {"id": "q-59-10", "category": "quran", "title": "For believers who preceded us in faith", "source": {"type": "quran", "surah": 59, "ayahs": [10]}, "arabic": {"from": "ربنا اغفر لنا", "to": "رءوف رحيم"}, "translation": {"from": "Our Lord, forgive us", "to": "Kind and Merciful."}}
 ]
}
